# EAS Build archive exclusions — keeps the upload small and fast.
# EAS always excludes node_modules and files ignored by .gitignore; these are
# extra heavy/generated files that do NOT need to go to the build server.

node_modules/
.expo/

# Native projects are regenerated by "expo prebuild --clean" on the build server.
android/
ios/

# Build artifacts / logs
dist/
*.apk
*.aab
*.log
gradle.log
build-log.txt
eas-build-log*
*.tsbuildinfo

# Question source data (huge SQL dumps ~25 MB). The app bundles its own
# offlineQuestions.json, and questions are imported into Appwrite directly.
*.sql

# Generated MCQ banks — kept locally, imported to Supabase separately (NOT part of the app).
*-nursing.json
*-management-nursing.json
drugcalc-nursing.json
research-nursing.json
procedures-nursing.json
leadership-nursing.json
hospital-management-nursing.json
# Local release artifacts & signing keys (NOT part of the build)
release/
release-keystores/
*.keystore
*.jks
