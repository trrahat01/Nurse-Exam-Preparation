{
  "expo": {
    "name": "Nurse Exam Preparation",
    "slug": "nurse-exam-preparation",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nurse-exam-prep",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0891B2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nurseexampreparation.nursing",
      "buildNumber": "40"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0891B2"
      },
      "package": "com.nurseexampreparation.nursing",
      "googleServicesFile": "./google-services.json",
      "versionCode": 40,
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      "@react-native-firebase/app",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0891B2",
          "image": "./assets/images/adaptive-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7383364741984927~3313458389",
          "iosAppId": "ca-app-pub-7383364741984927~3313458389",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "98ff757f-2455-45ec-b47d-6ab79b45ff9f"
      }
    },
    "owner": "trdevworkss-team"
  }
}

