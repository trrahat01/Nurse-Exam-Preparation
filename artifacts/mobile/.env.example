# Appwrite Configuration
# Get these values from your Appwrite console (Settings -> General / API).
# NOTE: the server/Admin API key must NEVER go in this file or the app.

EXPO_PUBLIC_APPWRITE_PROJECT_ID=6a7f8d46003d6384946a
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://tor.cloud.appwrite.io/v1

# Create a Database in Appwrite and paste its ID here, plus the collection IDs:
EXPO_PUBLIC_APPWRITE_DATABASE_ID=
EXPO_PUBLIC_APPWRITE_COLL_QUESTIONS=questions
EXPO_PUBLIC_APPWRITE_COLL_BOOKMARKS=bookmarks
EXPO_PUBLIC_APPWRITE_COLL_RESULTS=mock_results
EXPO_PUBLIC_APPWRITE_COLL_PROFILES=profiles

# Redirect base for email verification / password reset (your GitHub Pages site)
EXPO_PUBLIC_APPWRITE_REDIRECT_BASE=https://trrahat01.github.io/nurse-prep-pages