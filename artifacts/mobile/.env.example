# Supabase Configuration
# Get these values from your Supabase project dashboard (https://supabase.com)
# Go to Settings > API

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_PLACEHOLDER

# Note: The app will work in mock/offline mode without these variables.
# Set these only when you have a Supabase project set up.